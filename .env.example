# Copy this file to .env.local and put your real values THERE (never in this file — it gets committed).

# Powers the AI assistant. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Password for the admin page (yoursite.com/#admin). Choose a long one.
ADMIN_PASSWORD=

# On Vercel this is added automatically when you connect a Blob store.
# Locally you can leave it empty: admin changes are saved to content.local.json instead.
BLOB_READ_WRITE_TOKEN=
