# Copy this file to .env.local (never commit it) and fill in the values.

# Powers the AI assistant. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Password for the admin page (yoursite.com/#admin). Choose a long one.
ADMIN_PASSWORD=

# On Vercel this is added automatically when you connect a Blob store.
# Locally you can leave it empty: admin changes are saved to content.local.json instead.
BLOB_READ_WRITE_TOKEN=
